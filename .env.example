# Public origin for invite, magic-link, and recovery redirect_to.
# Production: https://pulse.jordanfitness.com
# Leave blank on Vercel to use https://$VERCEL_URL.
NEXT_PUBLIC_SITE_URL=
# Preview branches: set these as branch-scoped Vercel env vars for the TEST
# project jqdhkrlopmgbwbjebgxy (https://jqdhkrlopmgbwbjebgxy.supabase.co).
# Never point a branch preview at the production Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEARCH_AGENT_TOKEN=
# Server only. Leave blank to keep the fixture Cin7 adapter. Never use NEXT_PUBLIC_ for these.
CIN7_ACCOUNT_ID=
CIN7_APPLICATION_KEY=
# Server only. Blank keeps email as a log row and does not call Resend.
RESEND_API_KEY=
# Preview only. When set, Resend delivers to this address instead of the subcontractor.
EMAIL_REDIRECT_TO=
# Signing secret from the Resend inbound webhook. Required before replies are stored.
RESEND_WEBHOOK_SECRET=
# Full-access key for GET /emails/receiving/{id}. A sending-only RESEND_API_KEY cannot read bodies.
RESEND_INBOUND_API_KEY=
# Host for q-<token>@ reply addresses. MX for this host is documented in docs/replies-subdomain-dns.md.
RESEND_INBOUND_DOMAIN=replies.jordanfitness.com
# Optional. Set to 1 to ask a model for a price suggestion after the regex. No key means the regex is used.
SUBCONTRACTOR_PRICE_LLM=
LLM_API_KEY=
LLM_MODEL=
